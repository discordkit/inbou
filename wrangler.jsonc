{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inbou",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  // No `nodejs_compat`. @discordkit/gateway runs on the bare Workers runtime —
  // Web-standard WebSocket, no Node builtins — and keeping the flag off means a
  // dependency that quietly needs a Node shim fails the bundle check instead of
  // shipping. `vp run check:bundle` enforces it.
  "compatibility_flags": [],
  "services": [{ "binding": "HANDLERS", "service": "inbou-handlers" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT",
        "class_name": "InbouBot"
      }
    ]
  },
  "migrations": [
    {
      // SQLite-backed DOs are the free-plan class, and the only one whose
      // storage works locally under `wrangler dev`.
      "tag": "v1",
      "new_sqlite_classes": ["InbouBot"]
    }
  ],
  // The Gateway needs a live socket, which a request-scoped Worker cannot hold.
  // A cron trigger wakes the Worker so it can make sure the Durable Object —
  // and therefore the connection — is running, including after an eviction.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
