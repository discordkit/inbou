# Environment schema for 鸚法 (inbou).
#
# This file is COMMITTED and must never hold real values — it declares the shape
# and the rules. Put real values in a local `.env`, which is gitignored. Varlock
# validates against this schema and redacts anything marked @sensitive from logs.
#
# NOTE: the Worker does not import varlock's in-Worker `ENV`. That requires the
# `nodejs_compat` flag, and this Worker runs on the bare Workers runtime by
# design (`vp run check:bundle` fails the build if a Node builtin appears). The
# varlock CLI runs in Node outside the Worker, so the schema still validates and
# `.env` still watches; the Worker just reads the plain bindings it injects.

# @defaultRequired=true
# @defaultSensitive=true
# ---

# The bot token (Developer Portal → Bot → Reset Token). Authenticates both the
# Gateway connection and the REST calls the bot makes.
# @sensitive
DISCORD_BOT_TOKEN=

# The application's ID (Developer Portal → General Information). Needed to
# register slash commands. Public: it appears in invite URLs.
# @sensitive=false
DISCORD_APPLICATION_ID=

# The guild to register commands into during development. Guild commands appear
# immediately, while global ones can take up to an hour to propagate — so a dev
# loop wants this set. Leave it empty to register globally.
# @sensitive=false
# @required=false
DISCORD_GUILD_ID=
